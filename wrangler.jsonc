{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  // No `assets` block: @astrojs/cloudflare generates it at build time.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chrisnowicki-emdash",
      // TODO: replace after wrangler d1 create
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "chrisnowicki-emdash-media",
    },
  ],
  // Every minute: publishes posts scheduled in EmDash.
  "triggers": { "crons": ["* * * * *"] },
}
