{
  "version": "1",
  "collections": [
    {
      "slug": "posts",
      "label": "Posts",
      "labelSingular": "Post",
      "supports": ["drafts", "revisions", "preview", "scheduling", "search"],
      "urlPattern": "/blog/{slug}",
      "titleField": "title",
      "dateField": "date",
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "description",
          "label": "Description",
          "type": "text",
          "required": true,
          "searchable": true
        },
        {
          "slug": "date",
          "label": "Date",
          "type": "datetime",
          "required": true,
          "indexed": true
        },
        { "slug": "cover", "label": "Cover", "type": "image" },
        {
          "slug": "content",
          "label": "Content",
          "type": "portableText",
          "searchable": true
        }
      ]
    }
  ],
  "content": {
    "posts": []
  }
}
