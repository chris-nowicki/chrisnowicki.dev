---
import Container from '@/components/Container.astro'
import Hero from '@/components/Hero.astro'
import LatestPosts from '@/components/LatestPosts.astro'
import NowCard from '@/components/NowCard.astro'
import Podcast from '@/components/Podcast.astro'
import Separator from '@/components/Separator.astro'
import Speaking from '@/components/Speaking.astro'
import Uses from '@/components/Uses.astro'
import PageLayout from '@/layouts/PageLayout.astro'
import { HOME } from '@/lib/site'
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <Hero />
    <Separator />
    <LatestPosts />
    <Separator />
    <section aria-labelledby="bento-heading">
      <h2 id="bento-heading" class="mb-6 text-lg font-semibold tracking-tight sm:text-2xl">Beyond the code</h2>
      <div class="grid min-w-0 gap-3 md:grid-cols-12 md:gap-4 [&>*]:min-w-0 md:[&>:nth-child(odd)]:col-span-7 md:[&>:nth-child(even)]:col-span-5">
        <Speaking />
        <Podcast />
        <Uses />
        <NowCard />
      </div>
    </section>
  </Container>
</PageLayout>
