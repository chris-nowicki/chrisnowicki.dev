---
import '@/styles/global.css'

import { Font } from 'astro:assets'

import Container from '@/components/Container.astro'
import Footer from '@/components/Footer.astro'
import PageFrame from '@/components/PageFrame.astro'
import PageHeader from '@/components/PageHeader.astro'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta
      name="description"
      content="The requested page could not be found. Browse Chris Nowicki's site or use its machine-readable indexes."
    />
    <link rel="canonical" href="https://www.chrisnowicki.dev/404" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <Font cssVariable="--font-geist" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-geist-mono" preload />
    <Font cssVariable="--font-reenie" preload />
    <title>Page not found | Chris Nowicki</title>
  </head>
  <body>
    <a
      href="#main-content"
      class="focus:bg-background focus:text-foreground focus:ring-ring focus:ring-offset-background sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:px-4 focus:py-2 focus:shadow-lg focus:ring-2 focus:ring-offset-2 focus:outline-none">
      Skip to main content
    </a>
    <div class="relative flex min-h-screen shrink-0 flex-col">
      <PageFrame />
      <Container>
        <nav class="flex h-22 items-center" aria-label="Return home">
          <a
            href="/"
            class="font-cursive text-foreground text-4xl"
            aria-label="Chris Nowicki home">
            CN
          </a>
        </nav>
      </Container>
      <main id="main-content" class="flex-1" tabindex="-1">
        <Container>
          <section class="pt-12 text-sm sm:pt-20 sm:text-base">
            <PageHeader
              title="Page not found"
              subtitle="That address does not point to a page on this site."
            />

            <div class="mx-auto max-w-2xl">
              <h2 class="text-xl font-semibold sm:text-2xl">
                Choose another route
              </h2>
              <p class="text-muted-foreground mt-3 leading-relaxed">
                Return to the <a
                  class="text-foreground underline underline-offset-4"
                  href="/">home page</a
                >, browse the <a
                  class="text-foreground underline underline-offset-4"
                  href="/blog">blog</a
                >, learn more <a
                  class="text-foreground underline underline-offset-4"
                  href="/about">about Chris</a
                >, or use the <a
                  class="text-foreground underline underline-offset-4"
                  href="/contact">contact page</a
                >.
              </p>

              <h2 class="mt-8 text-xl font-semibold sm:text-2xl">
                Looking for an index?
              </h2>
              <p class="text-muted-foreground mt-3 leading-relaxed">
                The <a
                  class="text-foreground underline underline-offset-4"
                  href="/sitemap-index.xml">XML sitemap</a
                > lists published URLs. Agents and other automated readers can use
                <a
                  class="text-foreground underline underline-offset-4"
                  href="/llms.txt">llms.txt</a
                > for a concise guide to this site.
              </p>
            </div>
          </section>
        </Container>
      </main>
      <Footer />
    </div>
  </body>
</html>
