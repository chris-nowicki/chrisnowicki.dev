---
import Container from '@/components/Container.astro'
import PageHeader from '@/components/PageHeader.astro'
import PageLayout from '@/layouts/PageLayout.astro'

export const prerender = true

const TITLE = 'Page not found'
const DESCRIPTION = "That page doesn't exist, or it has moved."
---

<PageLayout title={TITLE} description={DESCRIPTION}>
  <Container>
    <section class="relative pt-12 text-sm sm:pt-20">
      <PageHeader title={TITLE} subtitle={DESCRIPTION} />
      <div class="flex flex-col items-center gap-4 text-center">
        <span class="font-cursive text-foreground text-4xl">404</span>
        <div class="flex gap-6 text-base">
          <a href="/" class="link-underline">
            Go home
          </a>
          <a href="/blog" class="link-underline">
            Read the blog
          </a>
        </div>
      </div>
    </section>
  </Container>
</PageLayout>
