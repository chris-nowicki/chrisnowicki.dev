---
import { getCollection } from 'astro:content'

import Container from '@/components/Container.astro'
import ListEntry from '@/components/ListEntry.astro'
import PageHeader from '@/components/PageHeader.astro'
import Separator from '@/components/Separator.astro'
import PageLayout from '@/layouts/PageLayout.astro'
import { WORK } from '@/lib/site'
import { getCareerByYear } from '@/utils/career-helpers'
import generateOgImageUrl from '@/utils/og-image'
import { formatDate } from '@/utils/utils'

const years = getCareerByYear()

const selectedWork = (
  await getCollection('work', ({ data }) => import.meta.env.DEV || !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const ogImageUrl = generateOgImageUrl({
  header: `/${WORK.TITLE.toUpperCase()}`,
  description: WORK.DESCRIPTION,
})

const link =
  'underline decoration-muted-foreground/40 underline-offset-[3px] transition-colors duration-200 hover:decoration-foreground'
---

<PageLayout title={WORK.TITLE} description={WORK.DESCRIPTION} image={ogImageUrl}>
  <Container>
    <section class="pt-12 sm:pt-20">
      <PageHeader title={WORK.TITLE} subtitle={WORK.DESCRIPTION} />

      {
        selectedWork.length > 0 && (
          <>
            <Separator label="Selected Work" contained />
            <div>
              {selectedWork.map((item) => (
                <ListEntry
                  href={item.data.link ?? `/work/${item.id}`}
                  title={item.data.title}
                  date={formatDate(item.data.date.toDateString())}
                  description={item.data.description}
                  meta={item.data.company}
                  external={Boolean(item.data.link)}
                />
              ))}
            </div>
          </>
        )
      }

      <Separator label="Career" contained class="mt-14" />

      <div class="mt-8 space-y-8 border-l border-border pl-8">
        {
          years.map(([year, entries]) => (
            <div class="relative">
              <span
                class="absolute top-1 -left-9 h-2.5 w-2.5 rounded-full border-2 border-background bg-muted-foreground/50"
                aria-hidden="true"
              />
              <div class="font-mono text-xs uppercase tracking-widest text-muted-foreground">
                {year}
              </div>
              <ul class="mt-2 space-y-2">
                {entries.map((entry) => (
                  <li class="leading-relaxed text-foreground">
                    {entry.link ? (
                      <a
                        href={entry.link}
                        class={link}
                        {...(entry.external
                          ? { target: '_blank', rel: 'noopener noreferrer' }
                          : { 'data-astro-prefetch': true })}>
                        {entry.title}
                        {entry.external && <span aria-hidden="true"> ↗</span>}
                      </a>
                    ) : (
                      entry.title
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>
  </Container>
</PageLayout>
