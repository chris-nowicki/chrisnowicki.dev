---
import { getCollection } from 'astro:content'

import Container from '@/components/Container.astro'
import ListEntry from '@/components/ListEntry.astro'
import PageHeader from '@/components/PageHeader.astro'
import Separator from '@/components/Separator.astro'
import PageLayout from '@/layouts/PageLayout.astro'
import { WORK } from '@/lib/site'
import { getCareerByYear } from '@/utils/career-helpers'
import generateOgImageUrl from '@/utils/og-image'
import { formatDate } from '@/utils/utils'

const years = getCareerByYear()

const caseStudies = (
  await getCollection('work', ({ data }) => import.meta.env.DEV || !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const ogImageUrl = generateOgImageUrl({
  header: `/${WORK.TITLE.toUpperCase()}`,
  description: WORK.DESCRIPTION,
})

const link =
  'underline decoration-muted-foreground/40 underline-offset-[3px] transition-colors duration-200 hover:decoration-foreground'
---

<PageLayout title={WORK.TITLE} description={WORK.DESCRIPTION} image={ogImageUrl}>
  <Container>
    <section class="pt-12 sm:pt-20">
      <PageHeader title={WORK.TITLE} subtitle={WORK.DESCRIPTION} />

      <div class="mt-10 space-y-10">
        {
          years.map(([year, entries]) => (
            <div class="grid gap-2 sm:grid-cols-[6rem_1fr] sm:gap-6">
              <div class="font-mono text-xs uppercase tracking-widest text-muted-foreground sm:pt-1">
                {year}
              </div>
              <ul class="space-y-3">
                {entries.map((entry) => (
                  <li class="flex gap-3 leading-relaxed text-foreground">
                    <span class="select-none text-muted-foreground" aria-hidden="true">
                      —
                    </span>
                    <span>
                      {entry.link ? (
                        <a
                          href={entry.link}
                          class={link}
                          {...(entry.external
                            ? { target: '_blank', rel: 'noopener noreferrer' }
                            : { 'data-astro-prefetch': true })}>
                          {entry.title}
                          {entry.external && <span aria-hidden="true"> ↗</span>}
                        </a>
                      ) : (
                        entry.title
                      )}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      {
        caseStudies.length > 0 && (
          <>
            <Separator label="Case Studies" contained class="mt-14" />
            <div>
              {caseStudies.map((study) => (
                <ListEntry
                  href={`/work/${study.id}`}
                  title={study.data.title}
                  date={formatDate(study.data.date.toDateString())}
                  description={study.data.description}
                  meta={study.data.company}
                />
              ))}
            </div>
          </>
        )
      }
    </section>
  </Container>
</PageLayout>
