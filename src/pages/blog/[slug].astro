---
import BlogPostHeader from '@/components/BlogPostHeader.astro'
import Container from '@/components/Container.astro'
import { BlogPortableText } from '@/components/blog/portable-text'
import PageLayout from '@/layouts/PageLayout.astro'
import { applyCacheHint, getBlogPost } from '@/utils/blog-helpers'
import generateOgImageUrl from '@/utils/og-image'
import { readingTimeFromPortableText } from '@/utils/reading-time'
import { formatDate } from '@/utils/utils'

const { slug = '' } = Astro.params
const { post, cacheHint, isPreview } = await getBlogPost(slug)

// An empty-bodied 404 makes Astro render the (prerendered) 404 page with a
// real 404 status.
if (!post) return new Response(null, { status: 404 })

// Never cache a draft served through a preview link.
if (!isPreview) applyCacheHint(Astro.cache, cacheHint)

const postDate = formatDate(post.data.date.toDateString())
const postReadTime = readingTimeFromPortableText(post.data.content)

const ogImageUrl = generateOgImageUrl({
  header: '/BLOG',
  description: post.data.title,
  readTime: postReadTime,
})
---

<PageLayout
  title={post.data.title}
  description={post.data.description}
  image={ogImageUrl}>
  <div class="bg-border fixed top-0 left-0 z-50 h-1 w-full">
    <div
      id="reading-progress"
      class="bg-muted-foreground h-full w-0 transition-[width] duration-100">
    </div>
  </div>
  <Container>
    <article class="text-sm sm:text-base">
      <div class="page-animate" style="--delay: 0ms">
        <BlogPostHeader
          title={post.data.title}
          date={postDate}
          readTime={postReadTime}
          slug={post.id}
          cover={post.data.cover}
        />
      </div>
      <BlogPortableText
        value={post.data.content}
        class="page-animate mt-10"
        style="--delay: 150ms"
      />
      <span
        class="page-animate font-cursive text-foreground mt-8 block text-4xl"
        style="--delay: 200ms">- Chris</span
      >
    </article>
  </Container>
</PageLayout>

<script>
  function initReadingProgress() {
    const candidate = document.querySelector<HTMLElement>('#reading-progress')
    if (!candidate) return
    const progressBar = candidate

    let animationFrameId: number | undefined

    function updateReadingProgress() {
      const scrollHeight =
        document.documentElement.scrollHeight - window.innerHeight
      const progress =
        scrollHeight > 0 ? (window.scrollY / scrollHeight) * 100 : 0
      progressBar.style.width = `${Math.min(100, Math.max(0, progress))}%`
      animationFrameId = undefined
    }

    function handleReadingProgressScroll() {
      if (animationFrameId !== undefined) return
      animationFrameId = window.requestAnimationFrame(updateReadingProgress)
    }

    window.addEventListener('scroll', handleReadingProgressScroll, {
      passive: true,
    })
    updateReadingProgress()

    return () => {
      window.removeEventListener('scroll', handleReadingProgressScroll)
      if (animationFrameId !== undefined) {
        window.cancelAnimationFrame(animationFrameId)
      }
    }
  }

  let cleanupReadingProgress: (() => void) | undefined

  function reinitializeReadingProgress() {
    cleanupReadingProgress?.()
    cleanupReadingProgress = initReadingProgress()
  }

  function cleanupReadingProgressBeforeSwap() {
    cleanupReadingProgress?.()
    cleanupReadingProgress = undefined
  }

  reinitializeReadingProgress()
  document.addEventListener('astro:page-load', reinitializeReadingProgress)
  document.addEventListener(
    'astro:before-swap',
    cleanupReadingProgressBeforeSwap
  )
</script>
