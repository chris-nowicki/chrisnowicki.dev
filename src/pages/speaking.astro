---
import Container from '@/components/Container.astro'
import HoverList from "@/components/HoverList.astro";
import PageHeader from '@/components/PageHeader.astro'
import SpeakingResources from "@/components/SpeakingResources.astro";
import PageLayout from '@/layouts/PageLayout.astro'
import { SPEAKING } from '@/lib/site'
import generateOgImageUrl from '@/utils/og-image'
import { getSpeakingTalks } from '@/utils/speaking-helpers'
import { formatDate } from '@/utils/utils'

const speaking = await getSpeakingTalks()

const featured = speaking.find((talk) => talk.featured && talk.hasDetail)
const rest = speaking.filter((talk) => talk !== featured)

const ogImageUrl = generateOgImageUrl({
  header: `/${SPEAKING.TITLE.toUpperCase()}`,
  description: SPEAKING.DESCRIPTION,
})
---

<PageLayout
  title={SPEAKING.TITLE}
  description={SPEAKING.DESCRIPTION}
  image={ogImageUrl}>
  <Container>
    <section class="relative pt-12 text-sm sm:pt-20">
      <PageHeader title={SPEAKING.TITLE} subtitle={SPEAKING.DESCRIPTION} />

      {
        featured && (
          <article class="mb-10 rounded-2xl border border-border bg-card p-5 sm:mb-12 sm:p-8">
            <p class="mb-3 font-mono text-xs uppercase tracking-widest text-muted-foreground">Featured appearance</p>
            <p class="mb-3 text-sm text-muted-foreground">
              {featured.event && <span>{featured.event} · </span>}
              <time datetime={featured.date.toISOString()}>{formatDate(featured.date.toDateString())}</time>
            </p>
            <h2 class="text-2xl font-semibold leading-tight tracking-tight sm:text-3xl">
              <a class="bento-action hover:underline underline-offset-4" href={`/speaking/${featured.slug}`}>{featured.title}</a>
            </h2>
            <p class="mt-3 mb-4 max-w-prose leading-relaxed text-muted-foreground">{featured.description}</p>
            <SpeakingResources talk={featured} />
          </article>
        )
      }

      {rest.length > 0 && <h2 class="mb-3 font-mono text-xs uppercase tracking-widest text-muted-foreground">{featured ? "Previous talks" : "Talks & appearances"}</h2>}
      <HoverList class="-mx-3">
      <ul class="relative">
        {rest.map((talk) => {
          const href = talk.hasDetail ? `/speaking/${talk.slug}` : talk.link;
          const Tag = href ? "a" : "div";
          return (
            <li>
              <Tag href={href}
                target={href && !talk.hasDetail ? "_blank" : undefined}
                rel={href && !talk.hasDetail ? "noopener noreferrer" : undefined}
                data-hover-row={href ? "" : undefined}
                class:list={["relative flex min-h-14 flex-col justify-center gap-1 rounded-lg px-3 py-4 sm:flex-row sm:items-center sm:gap-3", href && "bento-action focus-visible:bg-muted"]}>
                <h3 class="min-w-0 text-base font-medium leading-snug">
                  {talk.title}
                </h3>
                <span class="hidden h-px min-w-4 flex-1 bg-muted-foreground/20 sm:block" aria-hidden="true"></span>
                <time datetime={talk.date.toISOString()} class="shrink-0 whitespace-nowrap text-xs text-muted-foreground">
                  {formatDate(talk.date.toDateString())}
                </time>
              </Tag>
            </li>
          );
        })}
      </ul>
      </HoverList>
      {speaking.length === 0 && <p class="text-muted-foreground">No talks published yet.</p>}
    </section>
  </Container>
</PageLayout>
