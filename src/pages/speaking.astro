---
import { Image } from 'astro:assets'

import Headshot from '@/assets/images/me.jpg'
import Container from '@/components/Container.astro'
import ListEntry from '@/components/ListEntry.astro'
import PageHeader from '@/components/PageHeader.astro'
import Separator from '@/components/Separator.astro'
import PageLayout from '@/layouts/PageLayout.astro'
import { buttonVariants } from '@/lib/buttonVariants'
import { BIO, SPEAKING } from '@/lib/site'
import generateOgImageUrl from '@/utils/og-image'
import { getSpeakingData } from '@/utils/speaking-helpers'
import { formatDate } from '@/utils/utils'

const speaking = getSpeakingData()

const ogImageUrl = generateOgImageUrl({
  header: `/${SPEAKING.TITLE.toUpperCase()}`,
  description: SPEAKING.DESCRIPTION,
})

const kitButton = buttonVariants({
  variant: 'outline',
  size: 'sm',
  className: 'gap-2',
})
---

<PageLayout
  title={SPEAKING.TITLE}
  description={SPEAKING.DESCRIPTION}
  image={ogImageUrl}>
  <Container>
    <section class="relative pt-12 text-sm sm:pt-20">
      <PageHeader title={SPEAKING.TITLE} subtitle={SPEAKING.DESCRIPTION} />

      <Separator label="For Organizers" contained />

      <p class="leading-relaxed text-muted-foreground">
        Inviting me to speak? Grab a headshot and a ready-to-use bio below.
        For anything else, email <a
          href="mailto:chris@chrisnowicki.dev"
          class="underline decoration-muted-foreground/40 underline-offset-[3px] transition-colors duration-200 hover:decoration-foreground"
          >chris@chrisnowicki.dev</a
        >.
      </p>

      <div class="mt-8 flex flex-col gap-8 sm:flex-row sm:items-start">
        <figure class="shrink-0 sm:w-48">
          <Image
            src={Headshot}
            alt="Chris Nowicki"
            width={400}
            height={444}
            class="w-full rounded-md grayscale transition-all duration-500 ease-in-out hover:grayscale-0"
          />
          <a
            href="/chris-nowicki-headshot.jpg"
            download="chris-nowicki-headshot.jpg"
            class:list={[kitButton, 'mt-3 w-full']}>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" x2="12" y1="15" y2="3"></line>
            </svg>
            Download headshot
          </a>
        </figure>

        <div class="flex-1">
          <p
            class="font-mono text-xs uppercase tracking-widest text-muted-foreground">
            Short bio
          </p>
          <p id="speaker-bio" class="mt-2 leading-relaxed text-foreground">
            {BIO}
          </p>
          <button
            type="button"
            data-copy-bio
            aria-label="Copy bio to clipboard"
            class:list={[kitButton, 'mt-3']}>
            <span data-copy-icon aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round">
                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
                ></path>
              </svg>
            </span>
            <span data-copy-label>Copy bio</span>
          </button>
        </div>
      </div>

      <Separator label="Talks & Appearances" contained class="mt-16" />

      <div class="mt-10">
        {
          speaking.map((talk) => (
            <ListEntry
              href={talk.link}
              title={talk.title}
              date={formatDate(talk.date)}
              description={talk.description}
              meta={talk.category.join(', ')}
              external
            />
          ))
        }
      </div>
    </section>
  </Container>
</PageLayout>

<script>
  const CHECK = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>`

  function initBioCopy() {
    const button =
      document.querySelector<HTMLButtonElement>('[data-copy-bio]')
    const bio = document.getElementById('speaker-bio')
    if (!button || !bio || button.dataset.wired) return
    button.dataset.wired = 'true'

    const icon = button.querySelector('[data-copy-icon]')
    const label = button.querySelector('[data-copy-label]')
    const iconHtml = icon?.innerHTML ?? ''

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(bio.innerText.trim())
        if (icon) icon.innerHTML = CHECK
        if (label) label.textContent = 'Copied'
        setTimeout(() => {
          if (icon) icon.innerHTML = iconHtml
          if (label) label.textContent = 'Copy bio'
        }, 1500)
      } catch {
        /* clipboard unavailable — leave the button as-is */
      }
    })
  }

  initBioCopy()
  document.addEventListener('astro:after-swap', initBioCopy)
</script>
