---
import Container from "@/components/Container.astro";
import PageHeader from "@/components/PageHeader.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import { PROFILE } from "@/lib/profile";
import { SITE, SPEAKING } from "@/lib/site";
import generateOgImageUrl from "@/utils/og-image";
import { getSpeakingTalks } from "@/utils/speaking-helpers";
import { formatDate } from "@/utils/utils";
const talks = await getSpeakingTalks();
---

<PageLayout
  title={SPEAKING.TITLE}
  description={SPEAKING.DESCRIPTION}
  image={generateOgImageUrl({
    header: "SPEAKING",
    description: "Talks, conversations, and shared ideas.",
  })}>
  <Container>
    <section class="mt-14 sm:mt-20">
      <PageHeader
        title="Speaking"
        subtitle="Talks and conversations about documentation, developer experience, and the things we learn along the way."
      />
      <a class="text-link mb-10 inline-block text-sm" href="#for-organizers">
        Organizing an event? ↓
      </a>
      <ul class="space-y-9">
        {talks.map((talk) => (
          <li>
            <p class="mb-2 text-sm text-muted-foreground">
              <time datetime={talk.date.toISOString()}>
                {formatDate(talk.date.toDateString())}
              </time>{" "}
              · {talk.category.join(" / ")}
              {talk.featured && (
                <span class="ml-3 text-accent-strong">Featured</span>
              )}
            </p>
            <h2 class="text-xl font-medium">
              <a
                class="text-link"
                href={talk.hasDetail ? `/speaking/${talk.slug}` : talk.link}>
                {talk.title}
              </a>
            </h2>
            {talk.event && (
              <p class="mt-1 text-sm text-muted-foreground">{talk.event}</p>
            )}
            <p class="mt-2 text-lg leading-relaxed text-muted-foreground">
              {talk.description}
            </p>
            {(talk.slidesSlug || talk.youtube) && (
              <p class="mt-2 text-sm text-muted-foreground">
                {[talk.slidesSlug && "Slides", talk.youtube && "Recording"]
                  .filter(Boolean)
                  .join(" · ")}
              </p>
            )}
          </li>
        ))}
      </ul>
      <section
        id="for-organizers"
        class="mt-16 scroll-mt-8"
        aria-labelledby="organizer-title">
        <h2 id="organizer-title" class="section-title">
          For organizers
        </h2>
        <p class="text-lg leading-relaxed text-muted-foreground">
          I’d love to talk about documentation infrastructure, developer
          experience, or agentic tooling at your event.{" "}
          <a class="text-link text-foreground" href={`mailto:${SITE.EMAIL}`}>
            Get in touch
          </a>
          .
        </p>
        <h3 class="mb-3 mt-8 text-sm font-medium">Short bio</h3>
        <p class="text-lg leading-relaxed text-muted-foreground">
          {PROFILE.speakerBio}
        </p>
        <div class="mt-8 flex items-center gap-5">
          <img
            src={PROFILE.headshot.url}
            width={PROFILE.headshot.width}
            height={PROFILE.headshot.height}
            alt="Chris Nowicki’s headshot"
            loading="lazy"
            class="h-auto w-20 rounded-lg"
          />
          <div>
            <a
              class="text-link text-sm"
              href={PROFILE.headshot.url}
              download="chris-nowicki-headshot.jpg">
              Download headshot ↓
            </a>
            <p class="mt-1 text-sm text-muted-foreground">
              Original JPEG · {PROFILE.headshot.width} ×{" "}
              {PROFILE.headshot.height} pixels
            </p>
          </div>
        </div>
      </section>
    </section>
  </Container>
</PageLayout>
