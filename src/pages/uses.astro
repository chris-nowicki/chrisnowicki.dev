---
import { Image } from "astro:assets";

import DeskSetup from "@/assets/images/desk-setup.webp";
import Container from "@/components/Container.astro";
import PageHeader from "@/components/PageHeader.astro";
import {
  coffeeData,
  gitHubData,
  hardwareData,
  softwareData,
} from "@/data/uses";
import PageLayout from "@/layouts/PageLayout.astro";
import { USES } from "@/lib/site";
import generateOgImageUrl from "@/utils/og-image";
const sections = [
  { title: "GitHub", items: gitHubData },
  { title: "Coffee", items: coffeeData },
  { title: "Software", items: softwareData },
  { title: "Hardware", items: hardwareData },
];
---

<PageLayout
  title={USES.TITLE}
  description={USES.DESCRIPTION}
  image={generateOgImageUrl({ header: "USES", description: USES.DESCRIPTION })}>
  <Container>
    <section class="mt-14 sm:mt-20">
      <PageHeader title="Uses" subtitle={USES.DESCRIPTION} />
      <Image
        src={DeskSetup}
        width={1000}
        alt="My desk setup"
        class="mb-14 h-auto w-full rounded-lg"
      />
      {sections.map(({ title, items }) => (
        <section class="mb-14" aria-labelledby={`uses-${title.toLowerCase()}`}>
          <h2 id={`uses-${title.toLowerCase()}`} class="section-title">
            {title}
          </h2>
          <ul class="space-y-7">
            {items.map((item) => (
              <li class="flex items-start gap-5">
                {"imageSrc" in item && typeof item.imageSrc === "string" && (
                  <img
                    src={item.imageSrc}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    width={72}
                    height={72}
                    class="h-16 w-16 shrink-0 rounded-lg bg-white object-contain p-1"
                  />
                )}
                <div class="min-w-0">
                  <h3 class="font-medium">
                    <a class="text-link" href={item.link}>
                      {item.title}{" "}
                      <span class="text-muted-foreground" aria-hidden="true">
                        ↗
                      </span>
                    </a>
                  </h3>
                  <p class="mt-1 text-lg leading-relaxed text-muted-foreground">
                    {item.description}
                  </p>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </section>
  </Container>
</PageLayout>
