---
import Container from '@/components/Container.astro'
import PageHeader from '@/components/PageHeader.astro'
import PageLayout from '@/layouts/PageLayout.astro'
import { PRIVACY, SITE } from '@/lib/site'
import generateOgImageUrl from '@/utils/og-image'

const ogImageUrl = generateOgImageUrl({
  header: `/${PRIVACY.TITLE.toUpperCase()}`,
  description: PRIVACY.DESCRIPTION,
})
---

<PageLayout
  title={PRIVACY.TITLE}
  description={PRIVACY.DESCRIPTION}
  image={ogImageUrl}>
  <Container>
    <section class="pt-12 text-sm sm:pt-20 sm:text-base">
      <PageHeader
        title={PRIVACY.TITLE}
        subtitle="A plain-language account of the limited data this site handles."
      />

      <article class="prose mx-auto max-w-3xl">
        <p class="text-muted-foreground text-sm">
          <time datetime="2026-08-29">Last updated August 29, 2026</time>
        </p>

        <p class="text-foreground text-lg leading-8">
          This is the privacy notice for chrisnowicki.dev. The site does not
          offer user accounts or accept payments. It uses limited analytics,
          remembers a theme preference in your browser, links to services run by
          other organizations, and provides an email address for direct contact.
          The details below explain each of those activities.
        </p>

        <section aria-labelledby="analytics-heading">
          <h2 id="analytics-heading">Plausible analytics</h2>
          <p>
            This site uses <a
              href="https://plausible.io/data-policy"
              target="_blank"
              rel="noopener noreferrer">Plausible Analytics</a
            > to count visits and understand aggregate traffic, including which pages
            are viewed and where visits are referred from. Plausible is a privacy-focused
            analytics service that does not set analytics cookies or build cross-site
            advertising profiles. The resulting aggregate information helps show which
            public pages are being used; it is not used to identify individual visitors.
          </p>
        </section>

        <section aria-labelledby="theme-heading">
          <h2 id="theme-heading">Theme preference</h2>
          <p>
            When you use the light and dark theme control, this site stores a
            value named <code>theme</code> in your browser’s local storage. The value
            is either <code>light</code> or <code>dark</code> and allows the site
            to apply the same choice on later pages and visits. It stays in your browser
            rather than being submitted through a form. If no preference is stored,
            the site uses your device’s color-scheme preference. You can remove the
            saved value by clearing site data in your browser.
          </p>
        </section>

        <section aria-labelledby="links-heading">
          <h2 id="links-heading">Outbound links</h2>
          <p>
            Pages on this site link to social profiles, published resources, and
            other external websites. Following one of those links takes you to a
            service with its own privacy practices. The destination may receive
            ordinary request information from your browser, such as the page
            requested and technical connection details. Review the destination’s
            notice if you want to understand how it handles that information. A
            link is not permission for an external service to use data beyond
            its own stated terms.
          </p>
        </section>

        <section aria-labelledby="email-heading">
          <h2 id="email-heading">Email correspondence</h2>
          <p>
            The <a href="/contact">contact page</a> uses an email link rather than
            a web form. If you send a message to <a
              href={`mailto:${SITE.EMAIL}`}>{SITE.EMAIL}</a
            >, your email address, message, and any details or attachments you
            choose to include are handled as ordinary email correspondence. They
            are used to read, respond to, and manage that conversation. Your
            email provider and the receiving email provider also process the
            message for delivery under their own terms. Please do not send
            sensitive personal information that is not needed for your inquiry.
          </p>
        </section>

        <section aria-labelledby="sale-heading">
          <h2 id="sale-heading">No sale of personal data</h2>
          <p>
            I do not sell or rent personal data provided through this site. This
            site does not use personal information to create advertising
            profiles. Analytics and direct email serve separate, limited
            purposes: aggregate understanding of public page traffic and
            correspondence you choose to begin.
          </p>
        </section>

        <section aria-labelledby="questions-heading">
          <h2 id="questions-heading">Questions</h2>
          <p>
            If you have a question about this notice or about information you
            have included in an email, contact me at <a
              href={`mailto:${SITE.EMAIL}`}>{SITE.EMAIL}</a
            >. You can also return to the <a href="/about">about page</a> for information
            about who operates this personal site.
          </p>
        </section>
      </article>
    </section>
  </Container>
</PageLayout>
