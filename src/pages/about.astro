---
import Container from '@/components/Container.astro'
import PageHeader from '@/components/PageHeader.astro'
import PageLayout from '@/layouts/PageLayout.astro'
import { ABOUT, SITE } from '@/lib/site'
import generateOgImageUrl from '@/utils/og-image'

const ogImageUrl = generateOgImageUrl({
  header: `/${ABOUT.TITLE.toUpperCase()}`,
  description: ABOUT.DESCRIPTION,
})
---

<PageLayout
  title={ABOUT.TITLE}
  description={ABOUT.DESCRIPTION}
  image={ogImageUrl}>
  <Container>
    <section class="pt-12 text-sm sm:pt-20 sm:text-base">
      <PageHeader
        title={ABOUT.TITLE}
        subtitle="Developer experience, clear communication, and a practical view of the web."
      />

      <div class="prose mx-auto max-w-3xl">
        <p class="text-foreground text-lg leading-8 sm:text-xl">
          Hi, I’m Chris Nowicki, a Developer Experience Engineer at Commerce
          based in the US. This site is my place to share useful work, record
          ideas, and make it easy to find what I’m publishing and speaking
          about.
        </p>

        <section aria-labelledby="work-heading">
          <h2 id="work-heading">What I do</h2>
          <p>
            Developer experience is the part of software work concerned with
            making tools, systems, and technical information easier for people
            to use. It brings engineering and communication together: a
            capability is only genuinely useful when someone can understand it,
            get started, and keep moving when the path is not obvious. That is
            the perspective I bring to my role at Commerce and to the material I
            publish here.
          </p>
          <p>
            I value direct explanations, practical examples, and interfaces that
            respect the person using them. The same standard applies to this
            site. Pages are kept focused, navigation stays predictable, and the
            content aims to be useful without getting in the way of the subject.
          </p>
        </section>

        <section aria-labelledby="site-heading">
          <h2 id="site-heading">What you’ll find here</h2>
          <p>
            The <a href="/blog">blog</a> contains writing on technology, work, life,
            and productivity. The <a href="/speaking">speaking archive</a> gathers
            conference talks and the supporting material available for them. The <a
              href="/uses">uses page</a
            > documents the hardware, software, and coffee behind the day-to-day setup.
            Together, those sections provide a public record of the topics and tools
            I choose to share.
          </p>
          <p>
            If you arrived with a specific question, those sections are the best
            place to begin. Each is written to stand on its own, and links lead
            to the original material when a topic continues elsewhere.
          </p>
        </section>

        <section aria-labelledby="connect-heading">
          <h2 id="connect-heading">Let’s connect</h2>
          <p>
            For a speaking opportunity, a developer experience conversation, a
            question about something published here, or another professional
            collaboration, visit the <a href="/contact">contact page</a>. You
            can also email me directly at <a href={`mailto:${SITE.EMAIL}`}
              >{SITE.EMAIL}</a
            >. The contact page explains which details are helpful to include
            and links to the public social profiles associated with this site.
          </p>
        </section>
      </div>
    </section>
  </Container>
</PageLayout>
