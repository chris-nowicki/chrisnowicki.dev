---
import { getCollection, render } from 'astro:content'

import CodeCopyButton from '@/components/CodeCopyButton.astro'
import Container from '@/components/Container.astro'
import PageHeader from '@/components/PageHeader.astro'
import Separator from '@/components/Separator.astro'
import PageLayout from '@/layouts/PageLayout.astro'
import { CHANGELOG } from '@/lib/site'
import generateOgImageUrl from '@/utils/og-image'
import { formatDate } from '@/utils/utils'

const entries = (
  await getCollection('changelog', ({ data }) => import.meta.env.DEV || !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

// `render()` is async, so resolve every entry's body up front and hand the
// list to the template rather than awaiting inside the map.
const releases = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  }))
)

const ogImageUrl = generateOgImageUrl({
  header: `/${CHANGELOG.TITLE.toUpperCase()}`,
  description: CHANGELOG.DESCRIPTION,
})
---

<PageLayout
  title={CHANGELOG.TITLE}
  description={CHANGELOG.DESCRIPTION}
  image={ogImageUrl}>
  <Container>
    <section class="pt-12 sm:pt-20">
      <PageHeader title={CHANGELOG.TITLE} subtitle={CHANGELOG.DESCRIPTION} />

      {
        releases.map(({ entry, Content }, idx) => (
          <article id={`v${entry.data.version}`} class="scroll-mt-24">
            {idx > 0 && <Separator contained class="my-12" />}

            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 font-mono text-xs uppercase tracking-widest text-muted-foreground">
              <a
                href={`#v${entry.data.version}`}
                class="text-foreground transition-colors hover:text-muted-foreground">
                v{entry.data.version}
              </a>
              <time>{formatDate(entry.data.date.toDateString())}</time>
            </div>

            {entry.data.title && (
              <h2 class="mt-3 text-xl font-semibold sm:text-2xl">
                {entry.data.title}
              </h2>
            )}
            {entry.data.summary && (
              <p class="mt-2 text-muted-foreground">{entry.data.summary}</p>
            )}

            <div class="prose changelog-body mt-6">
              <Content />
            </div>
          </article>
        ))
      }
    </section>
  </Container>
  <CodeCopyButton />
</PageLayout>

<style is:global>
  /* Render the Keep-a-Changelog `### Added / Changed / Removed` headings as
     small mono category labels rather than the large prose h3, so they read
     as tags above their bullet list and stay smaller than the release
     title. */
  .changelog-body h3 {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: hsl(var(--muted-foreground));
  }

  .changelog-body ul {
    margin-top: 0.5rem;
    margin-bottom: 0;
  }
</style>
