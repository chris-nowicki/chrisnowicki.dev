---
import { getCollection, render } from 'astro:content'

import Container from '@/components/Container.astro'
import SpeakingResources from "@/components/SpeakingResources.astro";
import YouTube from '@/components/YouTube.astro'
import PageLayout from '@/layouts/PageLayout.astro'
import generateOgImageUrl from '@/utils/og-image'
import { formatDate } from '@/utils/utils'

export async function getStaticPaths() {
  const talks = await getCollection(
    'speaking',
    ({ data }) => !import.meta.env.PROD || !data.draft
  )

  const talksWithDetail = talks.filter(
    (entry) =>
      Boolean(entry.data.slidesSlug) || (entry.body?.trim().length ?? 0) > 0
  )

  return talksWithDetail.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
const t = entry.data

const ogImageUrl = generateOgImageUrl({
  header: '/SPEAKING',
  description: t.title,
  supportingText: t.description,
})

---

<PageLayout title={t.title} description={t.description} image={ogImageUrl}>
  <Container>
    <article class="text-sm sm:text-base">
      <header class="mt-12 sm:mt-20">
        <a href="/speaking" class="bento-action mb-6 inline-flex min-h-11 items-center text-sm text-muted-foreground hover:text-foreground">← All talks & appearances</a>
        <p class="mb-3 text-sm text-muted-foreground">
          {t.event && <span>{t.event} · </span>}
          <time datetime={t.date.toISOString()}>{formatDate(t.date.toDateString())}</time>
        </p>
        <h1 class="max-w-3xl text-3xl font-semibold leading-tight tracking-tight sm:text-5xl">{t.title}</h1>
        <p class="mt-4 mb-5 max-w-prose text-base leading-relaxed text-muted-foreground sm:text-lg">{t.description}</p>
        <SpeakingResources talk={t} />
      </header>

      {
        t.youtube && (
          <div class="page-animate mt-10" style="--delay: 100ms">
            <YouTube id={t.youtube} title={t.title} />
          </div>
        )
      }

      {
        t.slidesSlug && (
          <div class="page-animate mt-10 flex flex-col gap-4" style="--delay: 150ms">
            <iframe
              src={`/slides/${t.slidesSlug}/index.html`}
              title="Slides"
              class="aspect-video w-full rounded-xl border border-border bg-muted"
              allowfullscreen
              loading="lazy"
            />

          </div>
        )
      }

      <div class="page-animate prose mt-10" style="--delay: 200ms">
        <Content />
      </div>

      <a
        href="/speaking"
        class="page-animate link-underline mt-10 inline-block text-muted-foreground hover:text-foreground"
        style="--delay: 250ms">
        ← Back to speaking
      </a>
    </article>
  </Container>
</PageLayout>
