---
interface Props {
  title: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
---

<header class="mb-10">
  <h1 class="text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">
    {title}
  </h1>
  {subtitle && (
    <p class="mt-4 max-w-xl text-lg leading-relaxed text-muted-foreground">
      {subtitle}
    </p>
  )}
</header>
