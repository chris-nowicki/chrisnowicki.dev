---
import { navLinks } from '@/lib/site'
import { cn } from '@/utils/utils'

const mobileNavLinks = [{ href: '/', text: 'Home' }, ...navLinks]
const pathname = Astro.url.pathname.split('/')[1]
---

<div class="mobile-nav md:hidden" data-mobile-nav>
  <button
    type="button"
    class="relative z-50 flex justify-center"
    aria-label="Open navigation menu"
    aria-controls="mobile-nav-panel"
    aria-expanded="false"
    data-nav-toggle>
    <span class="relative flex h-6 w-8 flex-col justify-between">
      <span
        class="bar bar-top bg-foreground absolute top-0 right-0 h-0.5 w-[40%]"
      ></span>
      <span
        class="bar bar-mid bg-foreground absolute top-1/2 right-0 h-0.5 w-[65%] -translate-y-1/2"
      ></span>
      <span
        class="bar bar-bot bg-foreground absolute right-0 bottom-0 h-0.5 w-full"
      ></span>
    </span>
  </button>

  <div
    class="backdrop fixed inset-0 z-30 bg-black/40"
    aria-hidden="true"
    data-nav-backdrop>
  </div>

  <div
    id="mobile-nav-panel"
    class="panel bg-background fixed top-0 right-0 bottom-0 z-40 w-[65vw] shadow-2xl"
    aria-hidden="true"
    inert
    data-nav-panel>
    <div class="h-full px-6 pt-24">
      <ul class="flex list-none flex-col items-start gap-1 text-xl">
        {
          mobileNavLinks.map(({ href, text }) => {
            const isActive =
              (text === 'Home' && pathname === '') ||
              text.toLowerCase() === pathname
            return (
              <li class="w-full">
                <a
                  href={href}
                  class={cn(
                    'block w-full rounded-lg px-3 py-2.5 transition-colors duration-200',
                    isActive ?
                      'bg-accent text-foreground font-medium'
                    : 'text-muted-foreground hover:text-foreground'
                  )}
                  aria-current={isActive ? 'page' : undefined}
                  data-astro-prefetch
                  data-nav-link>
                  {text}
                </a>
              </li>
            )
          })
        }
      </ul>
    </div>
  </div>
</div>

<style>
  /* Hamburger bars animate into an X when open */
  .bar {
    transition: all 0.3s ease;
  }
  .nav-open .bar-top {
    top: 50%;
    width: 100%;
    transform: translateY(-50%) rotate(45deg);
  }
  .nav-open .bar-mid {
    width: 100%;
    opacity: 0;
  }
  .nav-open .bar-bot {
    bottom: 50%;
    width: 100%;
    transform: translateY(50%) rotate(-45deg);
  }

  /* Backdrop fades in */
  .backdrop {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .nav-open .backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  /* Panel slides in from the right */
  .panel {
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .nav-open .panel {
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .bar,
    .backdrop,
    .panel {
      transition: none;
    }
  }
</style>

<script>
  function initMobileNav() {
    const root = document.querySelector<HTMLElement>('[data-mobile-nav]')
    if (!root) return

    const toggle = root.querySelector<HTMLButtonElement>('[data-nav-toggle]')
    const backdrop = root.querySelector<HTMLElement>('[data-nav-backdrop]')
    const panel = root.querySelector<HTMLElement>('[data-nav-panel]')
    const links = root.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')
    if (!toggle || !backdrop || !panel) return

    document.body.style.overflow = ''

    const setOpen = (open: boolean, restoreFocus = false) => {
      root.classList.toggle('nav-open', open)
      toggle.setAttribute('aria-expanded', String(open))
      toggle.setAttribute(
        'aria-label',
        open ? 'Close navigation menu' : 'Open navigation menu'
      )
      panel.setAttribute('aria-hidden', String(!open))
      panel.inert = !open
      document.body.style.overflow = open ? 'hidden' : ''

      if (open) {
        links.item(0)?.focus()
      } else if (restoreFocus) {
        toggle.focus()
      }
    }

    const handleToggleClick = () => {
      setOpen(!root.classList.contains('nav-open'), true)
    }

    const handleBackdropClick = () => {
      setOpen(false, true)
    }

    const handleLinkClick = () => {
      setOpen(false)
    }

    const handleDocumentKeydown = (event: KeyboardEvent) => {
      if (!root.classList.contains('nav-open')) return

      if (event.key === 'Escape') {
        event.preventDefault()
        setOpen(false, true)
        return
      }

      if (event.key !== 'Tab' || links.length === 0) return

      const firstLink = links.item(0)
      const lastLink = links.item(links.length - 1)
      const activeElement = document.activeElement

      if (event.shiftKey && activeElement === toggle) {
        event.preventDefault()
        lastLink.focus()
      } else if (!event.shiftKey && activeElement === lastLink) {
        event.preventDefault()
        toggle.focus()
      } else if (!root.contains(activeElement)) {
        event.preventDefault()
        firstLink.focus()
      }
    }

    toggle.addEventListener('click', handleToggleClick)
    backdrop.addEventListener('click', handleBackdropClick)
    links.forEach((link) => link.addEventListener('click', handleLinkClick))
    document.addEventListener('keydown', handleDocumentKeydown)

    setOpen(false)

    return () => {
      toggle.removeEventListener('click', handleToggleClick)
      backdrop.removeEventListener('click', handleBackdropClick)
      links.forEach((link) =>
        link.removeEventListener('click', handleLinkClick)
      )
      document.removeEventListener('keydown', handleDocumentKeydown)
      setOpen(false)
    }
  }

  let cleanupMobileNav: (() => void) | undefined

  function reinitializeMobileNav() {
    cleanupMobileNav?.()
    cleanupMobileNav = initMobileNav()
  }

  function cleanupMobileNavBeforeSwap() {
    cleanupMobileNav?.()
    cleanupMobileNav = undefined
  }

  reinitializeMobileNav()
  document.addEventListener('astro:page-load', reinitializeMobileNav)
  document.addEventListener('astro:before-swap', cleanupMobileNavBeforeSwap)
</script>
