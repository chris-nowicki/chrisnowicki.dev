---
import { navLinks } from '@/lib/site'
import { cn } from '@/utils/utils'

const mobileNavLinks = [{ href: '/', text: 'Home' }, ...navLinks]
const pathname = Astro.url.pathname.split('/')[1]
---

<div class="mobile-nav md:hidden" data-mobile-nav>
  <button
    type="button"
    class="relative z-50 flex justify-center"
    aria-label="Toggle mobile menu"
    aria-expanded="false"
    data-nav-toggle>
    <span class="relative flex h-6 w-8 flex-col justify-between">
      <span class="bar bar-top absolute top-0 right-0 h-0.5 w-[40%] bg-foreground"></span>
      <span
        class="bar bar-mid absolute top-1/2 right-0 h-0.5 w-[65%] -translate-y-1/2 bg-foreground"
      ></span>
      <span class="bar bar-bot absolute right-0 bottom-0 h-0.5 w-full bg-foreground"></span>
    </span>
  </button>

  <div
    class="backdrop fixed inset-0 z-30 bg-black/40"
    aria-hidden="true"
    data-nav-backdrop>
  </div>

  <div class="panel fixed top-0 right-0 bottom-0 z-40 w-[65vw] bg-background shadow-2xl" data-nav-panel>
    <nav class="h-full px-6 pt-24">
      <ul class="flex list-none flex-col items-start gap-1 text-xl">
        {
          mobileNavLinks.map(({ href, text }) => {
            const isActive =
              (text === 'Home' && pathname === '') ||
              text.toLowerCase() === pathname
            return (
              <li class="w-full">
                <a
                  href={href}
                  class={cn(
                    'block w-full rounded-lg px-3 py-2.5 transition-colors duration-200',
                    isActive ?
                      'bg-accent font-medium text-foreground'
                    : 'text-muted-foreground hover:text-foreground'
                  )}
                  aria-current={isActive ? 'page' : undefined}
                  data-astro-prefetch
                  data-nav-link>
                  {text}
                </a>
              </li>
            )
          })
        }
      </ul>
    </nav>
  </div>
</div>

<style>
  /* Hamburger bars animate into an X when open */
  .bar {
    transition: all 0.3s ease;
  }
  .nav-open .bar-top {
    top: 50%;
    width: 100%;
    transform: translateY(-50%) rotate(45deg);
  }
  .nav-open .bar-mid {
    width: 100%;
    opacity: 0;
  }
  .nav-open .bar-bot {
    bottom: 50%;
    width: 100%;
    transform: translateY(50%) rotate(-45deg);
  }

  /* Backdrop fades in */
  .backdrop {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .nav-open .backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  /* Panel slides in from the right */
  .panel {
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .nav-open .panel {
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .bar,
    .backdrop,
    .panel {
      transition: none;
    }
  }
</style>

<script>
  function initMobileNav() {
    const root = document.querySelector<HTMLElement>('[data-mobile-nav]')
    if (!root) return

    const toggle = root.querySelector<HTMLButtonElement>('[data-nav-toggle]')
    const backdrop = root.querySelector<HTMLElement>('[data-nav-backdrop]')
    const links = root.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')
    if (!toggle || !backdrop) return

    // Reset scroll lock in case a previous page left it set (view transitions)
    document.body.style.overflow = ''

    const setOpen = (open: boolean) => {
      root.classList.toggle('nav-open', open)
      toggle.setAttribute('aria-expanded', String(open))
      document.body.style.overflow = open ? 'hidden' : ''
    }

    toggle.addEventListener('click', () =>
      setOpen(!root.classList.contains('nav-open'))
    )
    backdrop.addEventListener('click', () => setOpen(false))
    links.forEach((link) => link.addEventListener('click', () => setOpen(false)))
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false)
    })
  }

  initMobileNav()
  document.addEventListener('astro:after-swap', initMobileNav)
</script>
