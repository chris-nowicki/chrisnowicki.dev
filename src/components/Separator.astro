---
import { cn } from '@/utils/utils'

interface Props {
  label?: string
  class?: string
  // Accepted for call-site compatibility. Section rules are always
  // column-width now (the full-bleed / corner-mark variant was retired).
  contained?: boolean
}

const { label = '', class: className = '' } = Astro.props
---

{
  label ? (
    // Named section: a left-aligned mono "eyebrow" label. Whitespace does
    // the separating — no rule.
    <div class={cn('relative z-20 mt-16 mb-6', className)}>
      <span class="font-mono text-xs font-medium tracking-widest text-muted-foreground uppercase">
        {label}
      </span>
    </div>
  ) : (
    // Unlabeled divider: a dashed column-width rule.
    <div
      class={cn('relative z-20 my-10 w-full md:my-12', className)}
      aria-hidden="true">
      <div class="h-px w-full border-t border-dashed border-border" />
    </div>
  )
}
