---
import FramePlus from './FramePlus.astro'

interface Props {
  label?: string
  class?: string
}

const { label = '', class: className = '' } = Astro.props
---

<div
  class:list={[
    'relative left-1/2 z-20 -ml-[50vw] my-12 w-screen md:my-16',
    className,
  ]}
  aria-hidden="true">
  <div class="h-px w-full border-t border-dashed border-border"></div>

  {
    label && (
      <span class="absolute left-1/2 top-0 -translate-x-1/2 -translate-y-1/2 bg-background px-3 font-mono text-xs font-medium tracking-widest text-muted-foreground uppercase">
        {label}
      </span>
    )
  }

  <FramePlus position="left" />
  <FramePlus position="right" />
</div>
