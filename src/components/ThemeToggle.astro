<button
  type="button"
  data-theme-toggle
  aria-label="Switch color theme"
  class="inline-flex h-11 w-11 cursor-pointer items-center justify-center rounded-full text-muted-foreground hover:bg-muted hover:text-foreground active:scale-95">
  <svg
    class="h-[18px] w-[18px] dark:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true">
    <path d="M20.9 13a9 9 0 0 1-9.9-9.9A9 9 0 1 0 20.9 13Z" />
  </svg>
  <svg
    class="hidden h-[18px] w-[18px] dark:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
  </svg>
</button>
<script>
  document.addEventListener("click", (event) => {
    if (
      !(event.target instanceof Element) ||
      !event.target.closest("[data-theme-toggle]")
    )
      return;
    const dark = document.documentElement.classList.toggle("dark");
    document.documentElement.style.colorScheme = dark ? "dark" : "light";
    try {
      localStorage.setItem("theme", dark ? "dark" : "light");
    } catch {
      /* Theme still works when storage is unavailable. */
    }
    document
      .querySelector("[data-theme-toggle]")
      ?.setAttribute(
        "aria-label",
        dark ? "Switch to light theme" : "Switch to dark theme",
      );
  });
  function updateThemeLabel() {
    document
      .querySelector("[data-theme-toggle]")
      ?.setAttribute(
        "aria-label",
        document.documentElement.classList.contains("dark") ?
          "Switch to light theme"
        : "Switch to dark theme",
      );
  }
  document.addEventListener("astro:page-load", updateThemeLabel);
  document.addEventListener("site:theme-change", updateThemeLabel);
  updateThemeLabel();
</script>
