<button
  id="theme-toggle"
  type="button"
  class="cursor-pointer font-mono text-sm tracking-wide text-muted-foreground"
  aria-label="Toggle between light and dark theme">
  <span class="text-foreground dark:text-muted-foreground dark:hover:text-foreground"
    >light</span
  >
  <span class="text-muted-foreground/40" aria-hidden="true">/</span>
  <span class="text-muted-foreground hover:text-foreground dark:text-foreground"
    >dark</span
  >
</button>

<script>
  function initThemeToggle() {
    const btn = document.getElementById('theme-toggle')
    if (!btn) return
    btn.addEventListener('click', () => {
      document.documentElement.classList.toggle('dark')
    })
  }

  initThemeToggle()
  document.addEventListener('astro:after-swap', initThemeToggle)
</script>
