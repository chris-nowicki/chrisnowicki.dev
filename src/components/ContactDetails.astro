---
import { SITE, socialLinks } from "@/lib/site";
---

<div class="space-y-6 text-lg leading-relaxed">
  <p>
    Have something to share, an idea to work on together, or a speaking
    invitation? I’d love to hear from you.
  </p>
  <p>
    <a class="text-link" href={`mailto:${SITE.EMAIL}`}>
      {SITE.EMAIL}
    </a>
  </p>
  <ul class="flex flex-wrap gap-x-6 gap-y-3 text-base text-muted-foreground">
    {socialLinks.map(({ name, url }) => (
      <li>
        <a class="text-link" href={url}>
          {name} ↗
        </a>
      </li>
    ))}
  </ul>
  <p class="font-cursive text-4xl">- Chris</p>
</div>
