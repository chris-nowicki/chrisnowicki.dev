---
import { Image } from 'emdash/ui'

import { toMediaValue, type PTImage } from './utils'

interface Props {
  node: PTImage
  index?: number
  isInline?: boolean
}

const { node } = Astro.props
const image = node?.asset ? toMediaValue(node) : null
---

{image && (
  <figure>
    <Image
      image={image}
      alt={image.alt ?? ''}
      sizes="(max-width: 896px) 100vw, 896px"
    />
    {node.caption && <figcaption>{node.caption}</figcaption>}
  </figure>
)}
