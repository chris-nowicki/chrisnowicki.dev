---
import MediaPicture from '@/components/blog/MediaPicture.astro'

import { toMediaValue, type PTImage } from './utils'

interface Props {
  node: PTImage
  index?: number
  isInline?: boolean
}

const { node } = Astro.props
const image = node?.asset ? toMediaValue(node) : null

// Prose column is at most 896px; up to 2x for high-density screens.
const IMAGE_WIDTHS = [640, 828, 1080, 1280, 1668, 1792]
---

{image && (
  <figure>
    <MediaPicture
      image={image}
      widths={IMAGE_WIDTHS}
      sizes="(max-width: 896px) 100vw, 896px"
    />
    {node.caption && <figcaption>{node.caption}</figcaption>}
  </figure>
)}
