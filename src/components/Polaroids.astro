---
// Scattered, framed photo gallery for blog posts. Styling lives in
// `src/styles/global.css` (`.polaroids`) rather than a scoped `<style>`
// here: this component is only rendered inside MDX, and Astro doesn't
// collect the scoped styles of MDX-embedded components, so they'd silently
// drop from the build.
interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<div class:list={['polaroids', className]}>
  <slot />
</div>
