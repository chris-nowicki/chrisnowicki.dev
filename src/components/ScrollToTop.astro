---

---

<button
  id="scrollToTop"
  class="bg-foreground text-background pointer-events-none invisible fixed right-12 bottom-10 hidden cursor-pointer rounded-full p-3 opacity-0 shadow-lg transition-all duration-300 hover:scale-105 lg:block"
  aria-label="Scroll to top"
  aria-hidden="true"
  tabindex="-1">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    class="h-8 w-8"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor">
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
  </svg>
</button>

<script>
  function initScrollToTop() {
    const candidate = document.querySelector<HTMLButtonElement>('#scrollToTop')
    if (!candidate) return
    const scrollButton = candidate

    const scrollThreshold = 300

    function setScrollButtonVisible(visible: boolean) {
      scrollButton.classList.toggle('invisible', !visible)
      scrollButton.classList.toggle('pointer-events-none', !visible)
      scrollButton.style.opacity = visible ? '1' : '0'
      scrollButton.setAttribute('aria-hidden', String(!visible))
      scrollButton.tabIndex = visible ? 0 : -1

      if (!visible && document.activeElement === scrollButton) {
        scrollButton.blur()
      }
    }

    function handleScroll() {
      setScrollButtonVisible(window.scrollY > scrollThreshold)
    }

    function handleScrollToTopClick() {
      const prefersReducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches

      window.scrollTo({
        top: 0,
        behavior: prefersReducedMotion ? 'auto' : 'smooth',
      })
    }

    window.addEventListener('scroll', handleScroll, { passive: true })
    scrollButton.addEventListener('click', handleScrollToTopClick)
    handleScroll()

    return () => {
      window.removeEventListener('scroll', handleScroll)
      scrollButton.removeEventListener('click', handleScrollToTopClick)
      setScrollButtonVisible(false)
    }
  }

  let cleanupScrollToTop: (() => void) | undefined

  function reinitializeScrollToTop() {
    cleanupScrollToTop?.()
    cleanupScrollToTop = initScrollToTop()
  }

  function cleanupScrollToTopBeforeSwap() {
    cleanupScrollToTop?.()
    cleanupScrollToTop = undefined
  }

  reinitializeScrollToTop()
  document.addEventListener('astro:page-load', reinitializeScrollToTop)
  document.addEventListener('astro:before-swap', cleanupScrollToTopBeforeSwap)
</script>
