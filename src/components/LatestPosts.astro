---
import LatestPostsSection from '@/components/LatestPostsSection.astro'
import { NUMBER_OF_ENTRIES } from '@/lib/site'
import { LATEST_POST_CARD } from '@/lib/styles'
import { applyCacheHint, getBlogPosts } from '@/utils/blog-helpers'
import { readingTimeFromPortableText } from '@/utils/reading-time'
import { cn } from '@/utils/utils'

interface Props {
  limit?: number
}

const { limit = NUMBER_OF_ENTRIES } = Astro.props

const { posts, cacheHint } = await getBlogPosts(limit)
// Rendered as a server island, so this caches the island response.
applyCacheHint(Astro.cache, cacheHint)

const postItems = posts.map((post) => ({
  href: `/blog/${post.id}`,
  slug: post.id,
  name: post.data.title,
  description: post.data.description,
  readTime: readingTimeFromPortableText(post.data.content),
}))
---

{postItems.length > 0 && (
  <LatestPostsSection>
    {postItems.map((item, index) => (
      <a
        href={item.href}
        aria-label={`Read more about ${item.name}`}
        class={cn(LATEST_POST_CARD, 'animate-fade-in-up')}
        style={`animation-delay: ${index * 100}ms`}
        data-astro-prefetch>
        <div class="flex h-full flex-col py-4 sm:p-4">
          <h3 class="mb-0 text-base font-bold wrap-break-words sm:mb-2 sm:min-h-[2.5em] sm:text-xl">
            {item.name}
          </h3>

          {item.description && (
            <p class="mb-4 flex-1 text-sm text-muted-foreground">
              {item.description}
            </p>
          )}

          <div class="mt-auto pt-2 font-mono text-xs text-muted-foreground">
            {item.readTime}
          </div>
        </div>
      </a>
    ))}
  </LatestPostsSection>
)}
