---
import PostList from "@/components/PostList.astro";
import { getBlogPosts } from "@/utils/blog-helpers";
const latest = await getBlogPosts(3);
---

<section class="mb-14" aria-labelledby="latest-title">
  <h2 id="latest-title" class="section-title">
    Latest writing
  </h2>
  <PostList posts={latest} />
  <a href="/blog" class="text-link mt-6 inline-block text-base">
    All articles <span aria-hidden="true">→</span>
  </a>
</section>
