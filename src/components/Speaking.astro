---
import { getSpeakingTalks } from "@/utils/speaking-helpers";
const talks = await getSpeakingTalks();
const talk =
  talks.find((entry) => entry.featured) ??
  talks.find((entry) => entry.category.includes("Talk"));
---

<section aria-labelledby="speaking-title">
  <h2 id="speaking-title" class="section-title">
    Speaking
  </h2>
  {talk && (
    <>
      <h3 class="text-xl font-medium sm:text-[1.375rem]">
        <a
          class="text-link"
          href={talk.hasDetail ? `/speaking/${talk.slug}` : talk.link}>
          {talk.title}
        </a>
      </h3>
      <p class="mt-2 text-lg leading-relaxed text-muted-foreground">
        {talk.description}
      </p>
    </>
  )}
  <div class="mt-5 flex flex-wrap gap-x-6 gap-y-3 text-base">
    <a class="text-link" href="/speaking">
      All talks <span aria-hidden="true">→</span>
    </a>
    <a class="text-link" href="/speaking#for-organizers">
      For organizers <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>
