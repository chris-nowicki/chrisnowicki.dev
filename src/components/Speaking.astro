---
import { getSpeakingTalks } from "@/utils/speaking-helpers";
import { formatMonthYear } from "@/utils/utils";

const [talk] = await getSpeakingTalks(1);
const href = talk?.hasDetail ? `/speaking/${talk.slug}` : talk?.link ?? "/speaking";
const isExternal = href.startsWith("https://") || href.startsWith("http://");
---

<a href={href} target={isExternal ? "_blank" : undefined} rel={isExternal ? "noopener noreferrer" : undefined}
  class="bento-card card-link card-surface flex flex-col gap-5 bg-card p-5 md:p-7">
  <p class="bento-label text-muted-foreground">Latest talk</p>
  {talk ? (
    <>
      <h3 class="text-2xl font-semibold leading-tight tracking-tight sm:text-3xl">{talk.title}</h3>
      <p class="text-sm leading-relaxed text-muted-foreground">{talk.description}</p>
      <p class="text-xs text-muted-foreground">{[talk.event, formatMonthYear(talk.date.toDateString())].filter(Boolean).join(" · ")}</p>
    </>
  ) : <h3 class="text-2xl font-semibold">Speaking and sharing ideas</h3>}
  <span class="mt-auto inline-flex min-h-11 items-center gap-2 pt-2 text-sm font-medium">
    {talk ? "View talk" : "All talks"} <span class="bento-arrow" aria-hidden="true">{isExternal ? "↗" : "→"}</span>
  </span>
</a>
