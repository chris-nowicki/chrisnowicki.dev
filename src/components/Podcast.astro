---
import CompressedLogo from "@/assets/icons/compressed-fm.svg";
---

<a href="https://www.compressed.fm/" target="_blank" rel="noopener noreferrer"
  class="bento-card bento-podcast card-link card-surface flex flex-col gap-6 bg-black p-5 text-white md:p-7">
  <span class="bento-label text-white/60">Podcast · Co-host</span>
  <h3 class="my-auto py-3">
    <span class="sr-only">Compressed FM</span>
    <CompressedLogo aria-hidden="true" class="h-auto w-full" />
  </h3>
  <p class="text-sm leading-relaxed text-white/75">I co-host Compressed FM, a podcast about web design and development.</p>
  <span class="mt-auto inline-flex min-h-11 items-center gap-2 text-sm font-medium">Listen to the podcast <span class="bento-arrow" aria-hidden="true">↗</span></span>
</a>
