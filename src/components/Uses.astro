---
import { Image } from "astro:assets";
import DeskSetup from "@/assets/images/desk-setup.webp";
---

<a href="/uses" class="bento-card bento-gear card-link relative isolate flex min-h-72 flex-col overflow-hidden bg-muted">
  <div class="pointer-events-none absolute inset-0 -z-10">
    <Image src={DeskSetup} alt="" widths={[480, 800, 1200]}
      sizes="(min-width: 768px) 520px, 100vw" class="bento-image h-full w-full object-cover" loading="lazy" />
    <div class="absolute inset-0 bg-linear-to-b from-background via-background/85 to-background/40"></div>
    <div class="bento-gear-wash absolute inset-0 bg-background/20"></div>
  </div>
  <div class="flex flex-1 flex-col gap-3 p-5 md:p-7">
    <span class="bento-label text-muted-foreground">My setup</span>
    <h3 class="max-w-sm text-xl font-semibold leading-tight tracking-tight sm:text-2xl">The gear that keeps me caffeinated & coding</h3>
    <span class="mt-auto inline-flex min-h-11 w-fit items-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground">Explore my setup <span class="bento-arrow" aria-hidden="true">→</span></span>
  </div>
</a>
