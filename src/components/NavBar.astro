---
import Container from '@/components/Container.astro'
import { navLinks } from '@/lib/site'
import { cn } from '@/utils/utils'

import ThemeToggle from './ThemeToggle.astro'

const pathname = Astro.url.pathname.split('/')[1]
---

<Container class="mt-8 mb-4">
  <nav
    class="flex flex-wrap items-center gap-x-6 gap-y-2 text-muted-foreground"
    aria-label="Primary navigation">
    <a
      href="/"
      class="font-cursive mr-2 text-3xl leading-none text-foreground"
      aria-label="Chris Nowicki — home">
      CN
    </a>

    {
      navLinks.map(({ href, text }) => {
        const isActive = pathname === text.toLowerCase()
        return (
          <a
            {href}
            class={cn(
              'font-mono text-sm transition-colors duration-200',
              isActive ? 'text-foreground' : 'hover:text-foreground'
            )}
            aria-current={isActive ? 'page' : undefined}
            data-astro-prefetch>
            {text.toLowerCase()}
          </a>
        )
      })
    }

    <div class="ml-auto">
      <ThemeToggle />
    </div>
  </nav>
</Container>
