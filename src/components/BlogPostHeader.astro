---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

interface Props {
  title: string
  date: string
  readTime: string
  slug: string
  image?: ImageMetadata
  draft?: boolean
}

const { title, date, readTime, image } = Astro.props
---

<header class="relative mt-10 mb-14">
  <div
    class:list={[
      'pt-8 sm:pt-12',
      image ? 'pb-6' : 'pb-8 sm:pb-12',
    ]}>
    <div class="mb-4 flex justify-center sm:mb-6">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-dashed border-border px-4 py-1.5 font-mono text-xs uppercase tracking-widest text-muted-foreground sm:gap-3 sm:text-sm">
        <span>{date}</span>
        <span class="h-3 w-px bg-border" />
        <span>{readTime}</span>
      </span>
    </div>

    <h1
      class="mx-auto max-w-3xl text-center text-2xl font-bold leading-tight tracking-tight text-foreground sm:text-3xl md:text-4xl lg:text-5xl">
      {title}
    </h1>
  </div>

  {
    image && (
      <Image
        src={image}
        alt={title}
        width={1200}
        height={480}
        class="mb-8 aspect-[2.5/1] w-full rounded-md object-cover grayscale transition-all duration-500 ease-in-out hover:grayscale-0"
      />
    )
  }

  <div
    class="h-px w-full border-t border-border"
    aria-hidden="true"
  />
</header>
