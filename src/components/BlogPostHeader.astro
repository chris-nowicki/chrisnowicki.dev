---
import { Image } from "astro:assets";
import sharp from "sharp";
interface Props {
  title: string;
  date: string;
  readTime: string;
  slug: string;
  image?: string;
  draft?: boolean;
}
const { title, date, readTime, image, draft } = Astro.props;
const dimensions =
  image?.startsWith("/") ? await sharp(`public${image}`).metadata() : undefined;
---

<header class="mb-10 mt-14 sm:mt-20">
  <a href="/blog" class="text-link text-sm text-muted-foreground">
    ← All articles
  </a>
  <h1 class="mt-7 text-3xl font-semibold leading-tight tracking-tight sm:text-[2.5rem]">
    {title}
  </h1>
  <p class="mt-4 text-sm text-muted-foreground">
    {date}{" "}
    <span class="px-2" aria-hidden="true">
      ·
    </span>{" "}
    {readTime}
    {draft && <span class="ml-3">Draft</span>}
  </p>
  {image && dimensions ?
    <Image
      src={image}
      alt={title}
      width={dimensions.width!}
      height={dimensions.height!}
      loading="eager"
      class="mt-8 h-auto w-full rounded-lg"
    />
  : image ?
    <Image
      src={image}
      alt={title}
      inferSize
      loading="eager"
      class="mt-8 h-auto w-full rounded-lg"
    />
  : null}
</header>
